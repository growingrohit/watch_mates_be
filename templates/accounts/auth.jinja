{% extends "base.jinja" %}

{% block extra_css %}
<link rel="stylesheet" href="{{ static('css/auth.css') }}">
{% endblock %}

{% block content %}
<section class="auth-card" data-login-api="{{ login_api_url }}" data-register-api="{{ register_api_url }}">
  <h1 class="auth-title">Welcome to Watch Mates</h1>
  <p class="auth-subtitle">Sign in or create an account to start chatting over shared videos.</p>

  {% set active_tab = default_tab|default('login') %}
  {% include "components/auth_tabs.jinja" %}

  <form id="login-form" class="auth-panel{% if active_tab == 'login' %} is-visible{% endif %}" data-panel="login" novalidate>
    <div class="form-field">
      <label for="login-username">Username<span class="required">*</span></label>
      <input id="login-username" name="username" type="text" class="input" required autocomplete="username">
    </div>
    <div class="form-field">
      <label for="login-password">Password<span class="required">*</span></label>
      <input id="login-password" name="password" type="password" class="input" required autocomplete="current-password">
    </div>
    <button type="submit" class="btn btn-primary">Sign in</button>
    <p class="auth-switch">
      Don't have an account?
      <button type="button" class="link-btn" data-switch-tab="register">Create one</button>
    </p>
  </form>

  <form id="register-form" class="auth-panel{% if active_tab == 'register' %} is-visible{% endif %}" data-panel="register" novalidate>
    <div class="form-grid">
      <div class="form-field">
        <label for="reg-username">Username<span class="required">*</span></label>
        <input id="reg-username" name="username" type="text" class="input" required autocomplete="username">
      </div>
      <div class="form-field">
        <label for="reg-email">Email</label>
        <input id="reg-email" name="email" type="email" class="input" autocomplete="email">
      </div>
      <div class="form-field">
        <label for="reg-password">Password<span class="required">*</span></label>
        <input id="reg-password" name="password" type="password" class="input" required minlength="8" autocomplete="new-password">
      </div>
      <div class="form-field">
        <label for="reg-first-name">First name</label>
        <input id="reg-first-name" name="first_name" type="text" class="input" autocomplete="given-name">
      </div>
      <div class="form-field">
        <label for="reg-last-name">Last name</label>
        <input id="reg-last-name" name="last_name" type="text" class="input" autocomplete="family-name">
      </div>
      <div class="form-field">
        <label for="reg-country-code">Country code</label>
        <input id="reg-country-code" name="country_code" type="text" class="input" placeholder="+91">
      </div>
      <div class="form-field">
        <label for="reg-mobile">Mobile number</label>
        <input id="reg-mobile" name="mobile_number" type="text" class="input" autocomplete="tel">
      </div>
      <div class="form-field form-field-full">
        <label for="reg-display-name">Display name</label>
        <input id="reg-display-name" name="display_name" type="text" class="input">
      </div>
      <div class="form-field form-field-full">
        <label for="reg-bio">Bio</label>
        <textarea id="reg-bio" name="bio" class="input input-textarea" rows="2"></textarea>
      </div>
      <div class="form-field form-field-full">
        <label for="reg-avatar">Avatar URL</label>
        <input id="reg-avatar" name="avatar" type="url" class="input" placeholder="https://">
      </div>
    </div>
    <button type="submit" class="btn btn-primary">Create account</button>
    <p class="auth-switch">
      Already have an account?
      <button type="button" class="link-btn" data-switch-tab="login">Sign in</button>
    </p>
  </form>
</section>
{% endblock %}

{% block extra_js %}
<script src="{{ static('js/auth-page.js') }}"></script>
{% endblock %}
